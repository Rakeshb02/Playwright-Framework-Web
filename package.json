{
  "name": "playwright_web_framework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test --project=\"chromium-*\"",
    "test:chromium": "playwright test --project=\"chromium-*\"",
    "test:firefox": "playwright test --project=\"firefox-*\"",
    "test:webkit": "playwright test --project=\"webkit-*\"",
    "test:cross-browser": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:failed": "playwright test --last-failed",
    "test:smoke": "playwright test --project=\"chromium-*\" --grep @smoke",
    "test:regression": "playwright test --project=\"chromium-*\" --grep @regression",
    "test:negative": "playwright test --project=\"chromium-*\" --grep @negative",
    "test:positive": "playwright test --project=\"chromium-*\" --grep @positive",
    "test:auth": "playwright test tests/auth --project=\"chromium-*\"",
    "test:catalog": "playwright test tests/catalog --project=\"chromium-*\"",
    "test:e2e": "playwright test tests/e2e --project=\"chromium-*\"",
    "test:ci": "cross-env CI=1 playwright test --project=\"chromium-*\"",
    "test:allure": "playwright test --project=\"chromium-*\" && npm run allure:generate && npm run allure:open",
    "report:html": "playwright show-report",
    "allure:generate": "cp config/categories.json allure-results/ 2>/dev/null || true; allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "clean:reports": "rm -rf allure-results allure-report playwright-report test-results",
    "clean": "rm -rf allure-results allure-report playwright-report test-results",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0",
    "cross-env": "^10.1.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^18.0.10"
  }
}
